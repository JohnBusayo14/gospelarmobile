{
  "expo": {
    "name": "Gospelar",
    "slug": "newnew",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "scheme": "gospelar",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gospelar.app",
      "associatedDomains": [
        "applinks:gospelar.com",
        "applinks:www.gospelar.com"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "POST_NOTIFICATIONS",
        "READ_MEDIA_IMAGES",
        "READ_EXTERNAL_STORAGE",
        "VIBRATE"
      ],
      "googleServicesFile": "./google-services.json",
      "package": "com.gospelar.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "https",
              "host": "gospelar.com"
            },
            {
              "scheme": "https",
              "host": "www.gospelar.com"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/gofamint_logo.png",
          "color": "#2563EB",
          "sounds": [
            "./assets/notification.wav"
          ]
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Gospelar needs access to your photos so you can upload a profile picture for your Gospeler ID card."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Gospelar needs access to your media library to save downloaded content.",
          "savePhotosPermission": "Gospelar needs permission to save images to your device."
        }
      ],
      "expo-web-browser"
    ],
    "extra": {
      "eas": {
        "projectId": "8f41ae41-c68c-459a-9e7d-bfb0430076a6"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/8f41ae41-c68c-459a-9e7d-bfb0430076a6"
    }
  }
}
